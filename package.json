{
  "name": "supercompute",
  "version": "1.1.0",
  "description": "QUANTA - Sovereign Compute Platform on Base Chain",
  "type": "module",
  "scripts": {
    "dev": "tinacms dev -c \"wrangler dev\"",
    "tina:dev": "tinacms dev -c \"next dev\"",
    "tina:build": "tinacms build",
    "next:build": "npx next build",
    "full:build": "npx tinacms build && npx next build && node scripts/pin-to-ipfs.mjs",
    "pin": "node scripts/pin-to-ipfs.mjs",
    "deploy": "wrangler pages deploy out --project-name=supercompute",
    "deploy:staging": "wrangler pages deploy out --project-name=supercompute --branch staging --commit-dirty=true",
    "db:create": "wrangler d1 create supercompute",
    "db:push": "wrangler d1 execute supercompute --local --file=./schema.sql",
    "db:push:prod": "wrangler d1 execute supercompute --file=./schema.sql --env production",
    "test": "node --test tests/auth/login.test.js",
    "test:csp": "node --test tests/csp/csp-report.test.mjs tests/csp/inline-scripts.test.mjs",
    "check:inline-scripts": "node scripts/check-inline-scripts.mjs out",
    "test:headers": "node --test tests/headers/assert-headers.test.mjs",
    "check:headers": "node scripts/assert-headers.mjs",
    "check:headers:live": "node scripts/assert-headers.mjs --url https://supercompute.io",
    "preview": "wrangler pages project . --preview"
  },
  "dependencies": {
    "@cloudflare/workers-types": "^4.20250430.0",
    "@ensdomains/content-hash": "^3.1.1",
    "@ethereum-attestation-service/eas-sdk": "^2.9.1",
    "@tanstack/react-query": "^5.100.11",
    "@tinacms/cli": "^2.3.1",
    "fs-extra": "^11.3.5",
    "multiformats": "^14.0.5",
    "neo4j-driver": "^6.0.1",
    "next": "^16.2.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tinacms": "^3.8.1",
    "viem": "^2.48.11",
    "wagmi": "^3.6.15"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.24.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.0.0"
  },
  "packageManager": "yarn@1.22.22+sha1.ac34549e6aa8e7ead463a7407e1c7390f61a6610"
}
