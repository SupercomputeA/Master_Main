/*!
 * SUPERCOMPUTE Frontend Static Assets
 * Served from Cloudflare Workers
 */

/* Cross-origin isolation for SharedArrayBuffer */
Cross-Origin-Opener-Policy: same-origin
Cross-Origin-Embedder-Policy: require-corp

/* Cache policies */
*.html: Cache-Control: public, max-age=0, must-revalidate
*.css: Cache-Control: public, max-age=31536000, immutable
*.js: Cache-Control: public, max-age=31536000, immutable
*.png: Cache-Control: public, max-age=31536000, immutable
*.svg: Cache-Control: public, max-age=31536000, immutable

/* ENS resolver — short browser cache, longer CDN edge cache.
 * Server-side KV handles the heavy lifting (1h TTL); these headers
 * just spare the edge from re-hitting the Worker for repeat reads. */
/api/ens/*
  Cache-Control: public, max-age=60, s-maxage=300
  Access-Control-Allow-Origin: *

/* Security headers */
X-Content-Type-Options: nosniff
X-Frame-Options: DENY
Referrer-Policy: strict-origin-when-cross-origin