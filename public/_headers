# SUPERCOMPUTE — Cloudflare Pages headers
# Static export output (public/ -> out/ on build).
# NOTE: COEP require-corp was previously declared but never applied (missing
# path section). Intentionally NOT re-added: it would block cross-origin
# images/media that lack CORP headers. COOP same-origin kept (no render impact).
#
# CSP violation telemetry (card t_38a77267): the enforcing policy below reports
# every violation to /api/csp-report (Pages Function -> D1 table csp_reports).
# Read it with scripts/csp-report-stats.sh; see docs/csp-telemetry.md.
#   - Reporting-Endpoints / Report-To carry the ABSOLUTE prod URL, as the card
#     specifies. On a preview branch (branch.supercompute.pages.dev) the legacy
#     `report-uri` fallback is document-relative and therefore stays on the
#     preview origin; only modern-Chrome (report-to) reports go to prod.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.neynar.com https://fonts.gstatic.com https://mainnet.base.org https://eth.llamarpc.com https://ethereum-rpc.publicnode.com https://cloudflare-eth.com https://*.walletconnect.com https://*.walletconnect.org wss://*.walletconnect.com wss://*.walletconnect.org; media-src 'self' blob: https:; worker-src 'self' blob:; frame-src 'self' https://*.walletconnect.com https://*.walletconnect.org https://www.youtube.com https://calendly.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests; report-uri /api/csp-report; report-to csp
  Reporting-Endpoints: csp="https://supercompute.io/api/csp-report"
  Report-To: {"group":"csp","max_age":10886400,"endpoints":[{"url":"https://supercompute.io/api/csp-report"}]}
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Immutable hashed build assets
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.jpeg
  Cache-Control: public, max-age=31536000, immutable

/*.webp
  Cache-Control: public, max-age=31536000, immutable

# HTML — never cache stale
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
